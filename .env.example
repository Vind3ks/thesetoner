# Copy this file to .env on the server and fill it in. Never commit .env.

# Where to connect. FAF's chat is reached over WebSocket.
IRC_SERVER=wss://chat.faforever.com

# Nick, which is also the IRC account name.
IRC_USER=TheSetoner

# The fixed-user password FAF gave you.
IRC_PASS=

# Channels, comma separated, # optional.
# Start in a test channel; change to aeolus once it works there.
IRC_CHANNELS=setonertest

# true = log every line the server sends.
#IRC_DEBUG=false
